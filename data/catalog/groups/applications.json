{
  "id": "applications",
  "name": "Applications",
  "description": "Operations for managing application definitions",
  "endpoints": [
    {
      "id": "apps-get",
      "method": "GET",
      "path": "/app/{app_id}",
      "summary": "Get app definition",
      "description": "Retrieves the definition of an app including all fields, configuration, and metadata",
      "params": {
        "path": {
          "app_id": {
            "type": "integer",
            "required": true,
            "description": "The ID of the app"
          }
        },
        "query": {},
        "body": {}
      },
      "rateLimit": {
        "limit": 2500,
        "window": "hour"
      },
      "responseFormat": "{ app_id, name, status, fields: [...], config: {...} }"
    },
    {
      "id": "apps-list",
      "method": "GET",
      "path": "/app/",
      "summary": "List apps",
      "description": "Lists all apps accessible to the authenticated user",
      "params": {
        "path": {},
        "query": {
          "space_id": {
            "type": "integer",
            "required": false,
            "description": "Filter by space ID"
          }
        },
        "body": {}
      },
      "rateLimit": {
        "limit": 2500,
        "window": "hour"
      },
      "responseFormat": "[{ app_id, name, status, ... }, ...]"
    },
    {
      "id": "apps-fields",
      "method": "GET",
      "path": "/app/{app_id}/field/",
      "summary": "Get app fields",
      "description": "Retrieves all fields for an app with their configurations",
      "params": {
        "path": {
          "app_id": {
            "type": "integer",
            "required": true,
            "description": "The ID of the app"
          }
        },
        "query": {},
        "body": {}
      },
      "rateLimit": {
        "limit": 2500,
        "window": "hour"
      },
      "responseFormat": "[{ field_id, external_id, type, label, config: {...} }, ...]"
    },
    {
      "id": "apps-create",
      "method": "POST",
      "path": "/app/",
      "summary": "Create app",
      "description": "Creates a new app in a space",
      "params": {
        "path": {},
        "query": {},
        "body": {
          "space_id": {
            "type": "integer",
            "required": true,
            "description": "Space ID where app will be created"
          },
          "name": {
            "type": "string",
            "required": true,
            "description": "App name"
          },
          "fields": {
            "type": "array",
            "required": true,
            "description": "Array of field definitions"
          }
        }
      },
      "rateLimit": {
        "limit": 2500,
        "window": "hour"
      },
      "responseFormat": "{ app_id, name, status, ... }"
    },
    {
      "id": "apps-update",
      "method": "PUT",
      "path": "/app/{app_id}",
      "summary": "Update app",
      "description": "Updates app configuration",
      "params": {
        "path": {
          "app_id": {
            "type": "integer",
            "required": true,
            "description": "The ID of the app"
          }
        },
        "query": {},
        "body": {
          "name": {
            "type": "string",
            "required": false,
            "description": "Updated app name"
          }
        }
      },
      "rateLimit": {
        "limit": 2500,
        "window": "hour"
      },
      "responseFormat": "JSON object"
    },
    {
      "id": "apps-delete",
      "method": "DELETE",
      "path": "/app/{app_id}",
      "summary": "Delete app",
      "description": "Deletes an app (requires appropriate permissions)",
      "params": {
        "path": {
          "app_id": {
            "type": "integer",
            "required": true,
            "description": "The ID of the app"
          }
        },
        "query": {},
        "body": {}
      },
      "rateLimit": {
        "limit": 2500,
        "window": "hour"
      },
      "responseFormat": "JSON object"
    },
    {
      "id": "apps-install",
      "method": "POST",
      "path": "/app/{app_id}/install",
      "summary": "Install app",
      "description": "Installs an app from the app market",
      "params": {
        "path": {
          "app_id": {
            "type": "integer",
            "required": true,
            "description": "The ID of the app"
          }
        },
        "query": {},
        "body": {
          "space_id": {
            "type": "integer",
            "required": true,
            "description": "Space ID to install app in"
          }
        }
      },
      "rateLimit": {
        "limit": 2500,
        "window": "hour"
      },
      "responseFormat": "JSON object"
    },
    {
      "id": "apps-usage",
      "method": "GET",
      "path": "/app/{app_id}/usage",
      "summary": "Get app usage",
      "description": "Retrieves usage statistics for an app",
      "params": {
        "path": {
          "app_id": {
            "type": "integer",
            "required": true,
            "description": "The ID of the app"
          }
        },
        "query": {},
        "body": {}
      },
      "rateLimit": {
        "limit": 2500,
        "window": "hour"
      },
      "responseFormat": "{ item_count, view_count, ... }"
    }
  ]
}